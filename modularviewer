<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title>Product Viewer</title>
<style>
  html, body { margin:0; padding:0; height:100%; overflow:hidden; background:#eceef2; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  #app { position:relative; width:100%; height:100vh; }
  #canvas-container { width:100%; height:100%; }
  #navBar { position:absolute; top:12px; left:12px; z-index:10; display:none; gap:8px; }
  #navBar.visible { display:flex; }
  #navBar a {
    background:rgba(255,255,255,0.9); color:#333; text-decoration:none;
    font-size:12px; padding:7px 12px; border-radius:8px;
    box-shadow:0 2px 8px rgba(0,0,0,0.15); border:1px solid rgba(0,0,0,0.06);
  }
  #navBar a:hover { background:#fff; }
  .callout-label {
    position:absolute; transform: translate(-50%, -145%);
    background:#fff; color:#111; padding:10px 12px; border-radius:8px;
    font-size:12px; pointer-events:auto; min-width:150px; max-width:220px;
    box-shadow:0 4px 16px rgba(0,0,0,0.25); cursor:pointer; user-select:none;
    border:1px solid rgba(0,0,0,0.06);
    opacity:0; visibility:hidden; transition:opacity 0.12s ease;
  }
  .callout-label.visible { opacity:1; visibility:visible; }
  .callout-label .co-title { font-weight:700; margin-bottom:3px; }
  .callout-label .co-desc { color:#4a4d52; line-height:1.35; }
  .callout-label:after {
    content:''; position:absolute; left:50%; top:100%; transform:translateX(-50%);
    border:6px solid transparent; border-top-color:#fff;
  }
  .callout-dot {
    position:absolute; width:22px; height:22px; margin-left:-11px; margin-top:-11px;
    box-sizing:border-box;
    background:#3d7eff; border:2px solid white; border-radius:50%;
    box-shadow:0 0 0 4px rgba(61,126,255,0.3), 0 2px 6px rgba(0,0,0,0.4);
    pointer-events:auto; cursor:pointer; user-select:none;
    display:flex; align-items:center; justify-content:center;
    color:white; font-size:11px; font-weight:700; line-height:1;
    transition:transform 0.12s ease;
  }
  .callout-dot:hover { transform:scale(1.15); }
  .callout-dot::before {
    content:''; position:absolute; inset:-6px; border-radius:50%;
    border:1.5px solid rgba(61,126,255,0.6);
    animation: calloutPulse 2s ease-out infinite;
  }
  @keyframes calloutPulse {
    0% { transform:scale(0.8); opacity:0.8; }
    100% { transform:scale(1.6); opacity:0; }
  }
  #loading {
    position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
    color:#5a5d63; font-size:13px; z-index:15; background:#eceef2;
  }
</style>
</head>
<body>
<div id="app">
  <div id="canvas-container"></div>
  <div id="loading">Loading…</div>
  <div id="navBar"></div>
</div>

<script type="importmap">
{
  "imports": {
    "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
    "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"
  }
}
</script>

<script type="module">
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';

const EMBEDDED_PACKAGE = {"formatVersion":1,"shading":{"background":"#eceef2","exposure":1.65,"toneMapping":"Linear","keyLightIntensity":4.1,"fillLightIntensity":2.8,"hemiLightIntensity":1.1},"callouts":[{"x":-0.17317855325283024,"y":1.3892379790067921,"z":0.08807133838496989,"title":"MRP-2002 Panel","description":""},{"x":0.19390031787544082,"y":1.1571707002012535,"z":-0.020562278910023213,"title":"Key Switch","description":""},{"x":-0.19343700163935443,"y":1.1209122760073866,"z":-0.004153583532412734,"title":"Pull Station","description":""},{"x":0.006057343308745487,"y":1.1173261689175722,"z":0.07346782642156352,"title":"Electric Solenoid","description":""},{"x":-0.003718375050988686,"y":0.45620534807022695,"z":0.2123975508604944,"title":"Cylinder Strap","description":""},{"x":-0.09113538022002717,"y":2.346575144537,"z":-0.09152599804542064,"title":"Nozzle","description":""},{"x":0.11960857633200742,"y":1.8791399466539918,"z":-0.044475405670375175,"title":"Mini Horn","description":""},{"x":0.11541976799344894,"y":1.9793153122857619,"z":-0.01523119081838302,"title":"Horn/Strobe","description":""},{"x":0.10131137182403294,"y":0.8748990172619092,"z":0.05372019183889987,"title":"Schrader Valve","description":""},{"x":-0.09525999751385554,"y":0.8826866373119926,"z":0.05977748163906465,"title":"Burst Disc","description":""}],"modelUrl":"https://raw.githubusercontent.com/VFS25/3D/main/WEB.Modular.MCVN.glb"};

const container = document.getElementById('canvas-container');
const loadingEl = document.getElementById('loading');
const navBar = document.getElementById('navBar');

const TONE_MAP = {
  ACESFilmic: THREE.ACESFilmicToneMapping,
  Reinhard: THREE.ReinhardToneMapping,
  Cineon: THREE.CineonToneMapping,
  Linear: THREE.NoToneMapping,
};

const scene = new THREE.Scene();
scene.background = new THREE.Color(0xeceef2);

const camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.01, 1000);
camera.position.set(2.5, 1.8, 2.5);

const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setPixelRatio(window.devicePixelRatio);
renderer.setSize(container.clientWidth, container.clientHeight);
renderer.outputColorSpace = THREE.SRGBColorSpace;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.0;
container.appendChild(renderer.domElement);

const controls = new OrbitControls(camera, renderer.domElement);
controls.enableDamping = true;
controls.dampingFactor = 0.08;

const hemi = new THREE.HemisphereLight(0xffffff, 0x30323a, 1.1);
scene.add(hemi);
const key = new THREE.DirectionalLight(0xffffff, 2.2);
key.position.set(3, 5, 4);
scene.add(key);
const fill = new THREE.DirectionalLight(0xffffff, 0.6);
fill.position.set(-4, 2, -3);
scene.add(fill);

let currentModel = null;
let callouts = [];
const overlay = document.createElement('div');
overlay.style.position = 'absolute';
overlay.style.inset = '0';
overlay.style.pointerEvents = 'none';
document.getElementById('app').appendChild(overlay);

function base64ToArrayBuffer(base64) {
  const binary = atob(base64);
  const bytes = new Uint8Array(binary.length);
  for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
  return bytes.buffer;
}
function escapeHtml(s) {
  const div = document.createElement('div');
  div.textContent = s;
  return div.innerHTML;
}

function addCallout(localPoint, title, description, number) {
  const dotEl = document.createElement('div');
  dotEl.className = 'callout-dot';
  dotEl.textContent = number;
  overlay.appendChild(dotEl);

  const domEl = document.createElement('div');
  domEl.className = 'callout-label';
  domEl.innerHTML = '<div class="co-title">' + escapeHtml(title || '') + '</div>' +
    (description ? '<div class="co-desc">' + escapeHtml(description) + '</div>' : '');
  overlay.appendChild(domEl);

  const calloutObj = { point: localPoint, domEl, dotEl, visible: false };
  callouts.push(calloutObj);

  dotEl.addEventListener('click', (e) => {
    e.stopPropagation();
    calloutObj.visible = !calloutObj.visible;
    domEl.classList.toggle('visible', calloutObj.visible);
  });
  domEl.addEventListener('click', (e) => {
    e.stopPropagation();
    calloutObj.visible = false;
    domEl.classList.remove('visible');
  });
}

function updateCalloutPositions() {
  if (!currentModel) return;
  const rect = renderer.domElement.getBoundingClientRect();
  callouts.forEach(c => {
    const worldPoint = c.point.clone();
    currentModel.localToWorld(worldPoint);
    const screenPoint = worldPoint.clone().project(camera);
    const behindCamera = screenPoint.z > 1;
    const x = (screenPoint.x * 0.5 + 0.5) * rect.width;
    const y = (-screenPoint.y * 0.5 + 0.5) * rect.height;
    c.domEl.style.display = behindCamera ? 'none' : 'block';
    c.dotEl.style.display = behindCamera ? 'none' : 'block';
    c.domEl.style.left = x + 'px';
    c.domEl.style.top = y + 'px';
    c.dotEl.style.left = x + 'px';
    c.dotEl.style.top = y + 'px';
  });
}

// Nav bar from ?library= / ?exit= — target="_top" breaks out of a cross-origin iframe
const params = new URLSearchParams(window.location.search);
const libraryUrl = params.get('library');
const exitUrl = params.get('exit');
if (libraryUrl) {
  const a = document.createElement('a');
  a.href = libraryUrl; a.target = '_top'; a.textContent = '← Back to library';
  navBar.appendChild(a);
}
if (exitUrl) {
  const a = document.createElement('a');
  a.href = exitUrl; a.target = '_top'; a.textContent = 'Exit';
  navBar.appendChild(a);
}
if (libraryUrl || exitUrl) navBar.classList.add('visible');

// Load the embedded package immediately — no file picker, no fetch
const s = EMBEDDED_PACKAGE.shading || {};
scene.background = new THREE.Color(s.background || '#eceef2');
renderer.toneMapping = TONE_MAP[s.toneMapping] ?? THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = s.exposure ?? 1.0;
key.intensity = s.keyLightIntensity ?? 2.2;
fill.intensity = s.fillLightIntensity ?? 0.6;
hemi.intensity = s.hemiLightIntensity ?? 1.1;

const buffer = EMBEDDED_PACKAGE.modelUrl
  ? await fetch(EMBEDDED_PACKAGE.modelUrl).then(r => r.arrayBuffer())
  : base64ToArrayBuffer(EMBEDDED_PACKAGE.glbBase64);
const loader = new GLTFLoader();
loader.parse(buffer, '', (gltf) => {
  currentModel = gltf.scene;
  const box = new THREE.Box3().setFromObject(currentModel);
  const size = box.getSize(new THREE.Vector3());
  const center = box.getCenter(new THREE.Vector3());
  const maxDim = Math.max(size.x, size.y, size.z) || 1;
  const scale = 1.6 / maxDim;
  currentModel.scale.setScalar(scale);
  currentModel.position.sub(center.multiplyScalar(scale));
  scene.add(currentModel);

  (EMBEDDED_PACKAGE.callouts || []).forEach((c, i) => addCallout(new THREE.Vector3(c.x, c.y, c.z), c.title, c.description, i + 1));
  loadingEl.style.display = 'none';
}, (err) => {
  console.error(err);
  loadingEl.textContent = 'Failed to load scene.';
});

function handleResize() {
  const w = container.clientWidth, h = container.clientHeight;
  if (w === 0 || h === 0) return;
  camera.aspect = w / h;
  camera.updateProjectionMatrix();
  renderer.setSize(w, h);
}
new ResizeObserver(handleResize).observe(container);
window.addEventListener('resize', handleResize);

function animate() {
  requestAnimationFrame(animate);
  controls.update();
  updateCalloutPositions();
  renderer.render(scene, camera);
}
animate();
</script>
</body>
</html>
